# Supabase Enterprise Configuration (HTTPS / TLS 1.2+ with sslmode=require)
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Server-Side 256-bit Cryptographic Keys (NFR-02: Strictly server-only)
AUTH_JWT_SECRET=replace-with-32-byte-hex-hmac-sha256-signing-secret
DATA_AES256_KEY=replace-with-64-char-hex-aes-256-gcm-encryption-key

# Google Gemini API Key for OCR & Vision Extraction (Server-Side)
GEMINI_API_KEY=your-gemini-api-key


